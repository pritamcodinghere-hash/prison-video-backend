generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int              @id @default(autoincrement())
  fullName     String
  email        String           @unique
  password     String
  phone        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  role         UserRole         @default(VISITOR)
  status       UserStatus       @default(ACTIVE)
  alerts       Alert[]
  auditLogs    AuditLog[]
  familyMember FamilyMember?
  wallet       Wallet?
}

model Prison {
  id        Int          @id @default(autoincrement())
  name      String
  code      String       @unique
  address   String
  status    PrisonStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  devices   Device[]
  inmates   Inmate[]
  kiosks    Kiosk[]
}

model Inmate {
  id                 Int                @id @default(autoincrement())
  inmateNumber       String             @unique
  fullName           String
  photoUrl           String?
  prisonId           Int
  status             InmateStatus       @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  calls              Call[]
  callSchedules      CallSchedule[]
  familyMembers      FamilyMember[]
  incidents          Incident[]
  prison             Prison             @relation(fields: [prisonId], references: [id])
}

model FamilyMember {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique
  inmateId           Int
  relationship       String
  phone              String
  isBlocked          Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)

  // OTP verification
  otpCode            String?
  otpExpiresAt       DateTime?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  calls              Call[]
  callSchedules      CallSchedule[]
  devices            DeviceRegistration[]

  inmate             Inmate             @relation(fields: [inmateId], references: [id])
  user               User               @relation(fields: [userId], references: [id])
}

model CallSchedule {
  id             Int            @id @default(autoincrement())
  inmateId       Int
  familyMemberId Int
  scheduledAt    DateTime
  duration       Int
  status         ScheduleStatus @default(SCHEDULED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  call           Call?
  familyMember   FamilyMember   @relation(fields: [familyMemberId], references: [id])
  inmate         Inmate         @relation(fields: [inmateId], references: [id])
}

model Call {
  id             Int           @id @default(autoincrement())
  scheduleId     Int?          @unique
  inmateId       Int
  familyMemberId Int
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int?
  status         CallStatus    @default(WAITING)
  roomId         String?       @unique
  createdAt      DateTime      @default(now())
  billing        Billing?
  familyMember   FamilyMember  @relation(fields: [familyMemberId], references: [id])
  inmate         Inmate        @relation(fields: [inmateId], references: [id])
  schedule       CallSchedule? @relation(fields: [scheduleId], references: [id])
  recording      Recording?
}

model Billing {
  id             Int           @id @default(autoincrement())
  callId         Int           @unique
  amount         Decimal       @db.Decimal(10, 2)
  pricePerMinute Decimal       @db.Decimal(10, 2)
  duration       Int
  status         BillingStatus @default(PENDING)
  transactionId  String?
  createdAt      DateTime      @default(now())
  call           Call          @relation(fields: [callId], references: [id])
}

model Recording {
  id          Int             @id @default(autoincrement())
  callId      Int             @unique
  fileName    String
  storagePath String
  duration    Int?
  status      RecordingStatus @default(PROCESSING)
  createdAt   DateTime        @default(now())
  call        Call            @relation(fields: [callId], references: [id])
}

model Device {
  id           Int          @id @default(autoincrement())
  deviceCode   String       @unique
  name         String
  prisonId     Int
  status       DeviceStatus @default(ACTIVE)
  lastActiveAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  prison       Prison       @relation(fields: [prisonId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Alert {
  id         Int           @id @default(autoincrement())
  type       String
  message    String
  severity   AlertSeverity @default(MEDIUM)
  status     AlertStatus   @default(OPEN)
  userId     Int?
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
  user       User?         @relation(fields: [userId], references: [id])
}

model DeviceRegistration {
  id                Int          @id @default(autoincrement())
  familyMemberId    Int
  deviceFingerprint String
  deviceName        String?
  isTrusted         Boolean      @default(true)
  lastUsedAt        DateTime?
  createdAt         DateTime     @default(now())
  familyMember      FamilyMember @relation(fields: [familyMemberId], references: [id])

  @@unique([familyMemberId, deviceFingerprint])
}

model Wallet {
  id        Int           @id @default(autoincrement())
  userId    Int           @unique
  balance   Decimal       @db.Decimal(12, 2) @default(0)
  currency  String        @default("INR")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id        Int      @id @default(autoincrement())
  walletId  Int
  amount    Decimal  @db.Decimal(12, 2)
  type      String
  callId    Int?
  createdAt DateTime @default(now())
  wallet    Wallet   @relation(fields: [walletId], references: [id])
}

model Kiosk {
  id            Int          @id @default(autoincrement())
  serialNumber  String       @unique
  prisonId      Int
  name          String?
  status        KioskStatus  @default(PENDING)
  lastHeartbeat DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  prison        Prison       @relation(fields: [prisonId], references: [id])
}

model Incident {
  id          Int      @id @default(autoincrement())
  inmateId    Int?
  callId      Int?
  type        String
  severity    String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  inmate      Inmate?  @relation(fields: [inmateId], references: [id])
}

model Settings {
  id   Int  @id @default(1)
  data Json @default("{}")
}

enum UserRole {
  VISITOR
  WARDEN
  VENDOR
  KIOSK
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum KioskStatus {
  PENDING
  APPROVED
  REJECTED
  OFFLINE
}

enum PrisonStatus {
  ACTIVE
  INACTIVE
}

enum InmateStatus {
  ACTIVE
  INACTIVE
  RELEASED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ScheduleStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum CallStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
}

enum BillingStatus {
  PENDING
  PAID
  FAILED
}

enum RecordingStatus {
  PROCESSING
  READY
  FAILED
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  RESOLVED
}
